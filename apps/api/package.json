{
  "name": "@hamalert/api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API for HamAlert clients (api.hamalert.org). Adapts the OpenAPI contract onto the existing MongoDB documents used by the PHP site and the Node matcher.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.3.3",
    "ioredis": "^5.6.1",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.1.7",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.3",
    "@types/pngjs": "^6.0.5",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
